{
  "name": "salient",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source supply chain human rights screening, ranked by risk to people.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev --workspace @salient/web --",
    "build": "npm run build --workspace @salient/web",
    "preview": "npm run preview --workspace @salient/web --",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "data:fetch": "npm run fetch --workspace @salient/ingest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
